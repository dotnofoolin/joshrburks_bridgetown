<header class="site-header">
  <div class="container">
    <a class="brand" href="<%= relative_url '/' %>">
      <span class="brand-mark" aria-hidden="true"><%= @metadata.initials %></span>
      <span><%= @metadata.title %></span>
    </a>

    <nav class="site-nav" aria-label="Main">
      <ul>
        <% links.each do |link| %>
          <li>
            <a href="<%= relative_url link[:path] %>" aria-current="<%= current?(link[:path]) ? "page" : "false" %>"><%= link[:label] %></a>
          </li>
        <% end %>
      </ul>
    </nav>
  </div>
</header>
