<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<% resource_title = strip_html(strip_newlines(title)) %>
<title><% if resource_title.empty? || resource_title == "Index" %><%= metadata.title %> — <%= metadata.tagline %><% else %><%= resource_title %> | <%= metadata.title %><% end %></title>

<meta name="description" content="<%= (description.to_s.strip.empty? ? metadata.description : description) %>" />
<meta name="theme-color" content="#22282b" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Grotesk:wght@400;500;700&family=Space+Mono:wght@400;700&display=swap" />

<link rel="stylesheet" href="<%= asset_path :css %>" />
<script src="<%= asset_path :js %>" defer></script>
<%= live_reload_dev_js %>
