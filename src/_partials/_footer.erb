<footer class="site-footer">
  <div class="container">
    <p>© <%= Time.now.year %> <%= metadata.title %>. Built loud with Bridgetown.</p>
    <ul class="footer-links">
      <li><a href="mailto:<%= metadata.email %>">Email</a></li>
      <% Array(metadata.social).each do |link| %>
        <li><a href="<%= link["url"] %>" rel="me noopener"><%= link["label"] %></a></li>
      <% end %>
    </ul>
  </div>
</footer>
